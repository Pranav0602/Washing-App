# ---------------------------------------------------------------------------
# Backend configuration contract. Copy to .env and fill in real values.
# NEVER commit a filled-in .env. NEVER put production credentials in this file.
# ---------------------------------------------------------------------------

# --- core -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=                       # required (prod): openssl rand -base64 64
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
LOG_LEVEL=INFO
LOG_FORMAT=json                         # plain | json
SERVICE_NAME=carwash-api

# --- database (PostgreSQL) --------------------------------------------------
POSTGRES_DB=carwash
POSTGRES_USER=carwash
POSTGRES_PASSWORD=                       # required
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_DB=test_carwash
POSTGRES_CONN_MAX_AGE=60

# --- tokens / OTP -----------------------------------------------------------
JWT_SIGNING_KEY=                        # required (prod), defaults to DJANGO_SECRET_KEY
JWT_ISSUER=carwash
JWT_AUDIENCE=carwash-mobile
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
OTP_PEPPER=                             # required (prod)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24

# --- locale / money ---------------------------------------------------------
# Launch geography and currency are deployment decisions. The PDF requires an
# explicit currency and integer minor units; nothing is hardcoded.
DEFAULT_CURRENCY=INR
PLATFORM_TIMEZONE=Asia/Kolkata
TAX_BPS=0                               # 0 until a jurisdiction is confirmed
PLATFORM_FEE_BPS=1500

# --- CORS / proxy -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://ops.example.com
CSRF_TRUSTED_ORIGINS=https://ops.example.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# --- evidence storage -------------------------------------------------------
EVIDENCE_STORAGE_BACKEND=filesystem    # filesystem | s3
EVIDENCE_ROOT=./var/evidence
EVIDENCE_MAX_UPLOAD_BYTES=10485760
EVIDENCE_RETENTION_DAYS=180
EVIDENCE_SIGNED_URL_TTL_SECONDS=300

# --- payments ---------------------------------------------------------------
# The PDF requires a locally supported marketplace-capable provider, chosen at
# discovery and kept replaceable. Only the sandbox adapter ships by default.
PAYMENT_GATEWAY=sandbox                # sandbox | noop
PAYMENT_WEBHOOK_SECRET=                # required (prod): shared secret for HMAC verification
PAYMENT_AUTHORIZATION_WINDOW_HOURS=72
PAYMENT_CAPTURE_METHOD=on_completion
REFUND_APPROVAL_LIMIT_MINOR=500000

# --- push -------------------------------------------------------------------
PUSH_PROVIDER=noop                      # expo | noop
EXPO_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=

# --- ETA / maps -------------------------------------------------------------
ETA_PROVIDER=estimate                   # estimate | noop
ETA_ASSUMED_SPEED_KMH=22.0
ETA_TRAFFIC_FACTOR=1.35

# --- masked comms -----------------------------------------------------------
COMMS_PROVIDER=relay                    # relay | noop
COMMUNICATION_WINDOW_MINUTES=120

# --- dispatch ---------------------------------------------------------------
DISPATCH_OFFER_TTL_SECONDS=120
DISPATCH_OFFER_BATCH_SIZE=3
DISPATCH_MAX_ROUNDS=5
DISPATCH_DEFAULT_TRAVEL_LIMIT_KM=12.0
DISPATCH_ARRIVAL_PROMISE_MINUTES=30
DISPATCH_STALE_LOCATION_SECONDS=300
DISPATCH_MILESTONE_GRACE_MINUTES=20
DISPATCH_FAIRNESS_WEIGHT=0.25
DISPATCH_ETA_WEIGHT=1.0
DISPATCH_RELIABILITY_WEIGHT=0.5

# --- privacy ----------------------------------------------------------------
LOCATION_PING_RETENTION_HOURS=24
LOCATION_PING_MAX_ACCURACY_M=200

# --- outbox / notifications -------------------------------------------------
OUTBOX_MAX_ATTEMPTS=6
OUTBOX_BATCH_SIZE=50
NOTIFICATION_RETENTION_DAYS=30

# --- rate limits (DRF throttle scopes) --------------------------------------
RATE_LIMIT_OTP_REQUEST=5/15min
RATE_LIMIT_OTP_VERIFY=10/15min
RATE_LIMIT_QUOTE=30/min
RATE_LIMIT_BOOKING=10/hour
RATE_LIMIT_LOCATION=60/min
RATE_LIMIT_EVIDENCE=40/hour
RATE_LIMIT_COMMS=60/5min
RATE_LIMIT_OPS_WRITE=120/min
API_DEFAULT_PAGE_SIZE=20