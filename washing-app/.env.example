# ---------------------------------------------------------------------------
# Mobile environment configuration. Copy to .env and adjust.
# Only EXPO_PUBLIC_* variables reach the app bundle, and this app deliberately
# holds no secrets on the client.
# ---------------------------------------------------------------------------

# Base URL of the Django API, without the /api/v1 suffix (the client adds it).
#
#   Web / desktop    : http://localhost:8000
#   iOS simulator    : http://localhost:8000
#   Android emulator : http://10.0.2.2:8000
#   Physical device  : http://<your-lan-ip>:8000
#   Production       : https://api.example.com
#
# Pick the row that matches where you are running the app. 10.0.2.2 only resolves
# inside the Android emulator; from web, iOS or desktop it is an unroutable address,
# so requests stall for the full timeout budget and surface as "cannot reach the
# server" rather than as the config mistake they are. Loopback is the safer default
# because it is also what the backend's CORS allowlist expects (http://localhost:8081).
EXPO_PUBLIC_API_URL=http://localhost:8000

# development | staging | production. Purely informational.
EXPO_PUBLIC_ENV=development

# Set to false to hide evidence capture in the app (for device testing without a
# camera, or in an App Review build).
EXPO_PUBLIC_ENABLE_EVIDENCE_UPLOADS=true